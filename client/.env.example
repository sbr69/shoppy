# Browser-visible configuration. Never put server secrets, Stellar signing
# material, OAuth client secrets, or database URLs in this file.
VITE_API_URL=http://localhost:3001
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Optional observability. Both integrations are inactive when blank.
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
