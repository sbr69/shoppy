# ─── Server Environment Variables ───
# Copy this file to .env and fill in the values

# Server
PORT=3001
CLIENT_URL=http://localhost:5173

# Google OAuth — get from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID

# JWT Secret — use a strong random string in production
JWT_SECRET=change-this-to-a-long-random-string

# Master Secret — used to derive per-user encryption keys for Stellar private keys
# CRITICAL: changing this will make all existing encrypted keys unreadable
MASTER_SECRET=change-this-to-a-different-long-random-string

# Merchant Stellar Address (testnet — for testing purchases)
MERCHANT_STELLAR_ADDRESS=GAS7MXJI3CIRUPZTA75VBMJXAJGUYCLBPHCTZQWGC7OTVSAKZN553WYX
