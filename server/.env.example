NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173

# Obtain this from Google Cloud Console. The browser and server values must match.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GEMINI_API_KEY=

# Generate unique high-entropy values before production.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30m
MASTER_SECRET=replace-with-a-different-long-random-secret

# Register only ecommerce stores with a supported, authenticated agent API.
# The merchant address is testnet-only for this MVP.
# SUPPORTED_STORES_JSON=[{"id":"stellar-shop","name":"Stellar Shop","origin":"https://shop.example.test","apiBaseUrl":"https://shop.example.test","merchantStellarAddress":"G..."}]
