NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173
# OAuth callback base. Register ${SERVER_PUBLIC_URL}/api/sites/oauth/callback at the merchant.
SERVER_PUBLIC_URL=http://localhost:3001

# Obtain this from Google Cloud Console. The browser and server values must match.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GEMINI_API_KEY=

# Generate unique high-entropy values before production.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30m
MASTER_SECRET=replace-with-a-different-long-random-secret

# Supabase transaction-pooler connection string (server-side only).
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_POOL_MAX=10

# Stellar / Soroban. Testnet values shown; use mainnet values for production.
STELLAR_NETWORK=testnet
# Payment reconciliation runs inside the API process. Postgres job claims
# prevent duplicate work when more than one instance is running.
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
TRUSTLIST_CONTRACT_ID=
SPENDGUARD_CONTRACT_ID=
AGENT_WALLET_WASM_HASH=
# Native-XLM Stellar Asset Contract ID for the selected network.
SETTLEMENT_TOKEN_CONTRACT_ID=

# Register only ecommerce stores with a supported, authenticated agent API.
# OAuth client secret belongs only in this ignored server .env file.
# SUPPORTED_STORES_JSON=[{"id":"test-market","name":"Test Market","origin":"https://test-market-theta.vercel.app","apiBaseUrl":"https://test-market-theta.vercel.app","merchantStellarAddress":"G...","oauth":{"authorizationUrl":"https://test-market-theta.vercel.app/oauth/authorize","tokenUrl":"https://test-market-theta.vercel.app/oauth/token","clientId":"...","clientSecret":"...","scopes":["products:read","checkout:write","orders:write"]}}]
